    <!-- Local Folder Setup Dialogs -->
    <string name="dialog_folder_title">Link Eden Folder (Android/data)</string>
    <string name="dialog_folder_intro">Eden saves your Nintendo Switch games in:\nAndroid/data/dev.eden.eden_emulator/files/nand/user/save</string>
    <string name="dialog_folder_option_a_title">Option A — Native Eden Provider (Recommended on Android 14/15/16):</string>
    <string name="dialog_folder_option_a_steps">1. Tap the button below.\n2. In the Android file picker, open the left drawer (☰) and select the «Eden» icon.\n3. Navigate to nand → user → save and tap «Use this folder».</string>
    <string name="dialog_folder_option_a_button">Open Eden Documents Provider</string>
    <string name="dialog_folder_option_b_title">Option B — Direct Android/data path (Handhelds or custom folder):</string>
    <string name="dialog_folder_option_b_desc">Directly open Android/data/dev.eden.eden_emulator/files/nand/user/save or your Eden user folder.</string>
    <string name="dialog_folder_option_b_button">Open Android/data or custom folder</string>

    <string name="dialog_peanuts_folder_title">Link Peanuts Native (Requires Shizuku)</string>
    <string name="dialog_peanuts_folder_intro">Peanuts Native stores saves in:\nAndroid/data/dev.nxnative.android.peanuts/files/saves\n\n⚠️ Shizuku is required to access this folder on Android 11+ devices (such as Samsung Galaxy), because Android restricts Android/data and Peanuts Native does not expose a Documents Provider.</string>
    <string name="dialog_peanuts_folder_option_a_title">Option A — Shizuku Access (Required on Android 14/15/16 phones):</string>
    <string name="dialog_peanuts_folder_option_a_steps">1. Open the Shizuku app and start it using Wireless Debugging.\n2. Tap the button below and grant Shizuku permission.\n3. The app will automatically access the Peanuts Native saves folder.</string>
    <string name="dialog_peanuts_folder_option_a_button">Connect with Shizuku</string>
    <string name="dialog_peanuts_folder_option_b_title">Option B — Direct SAF picker (Handhelds or custom folder):</string>
    <string name="dialog_peanuts_folder_option_b_desc">Only if your device allows direct access to Android/data or you use a custom folder.</string>
    <string name="dialog_peanuts_folder_option_b_button">Open saves or custom folder</string>
    <string name="dialog_folder_unlink_button">Unlink this folder</string>

